{
  "pluginAlias": "HomebridgeTapoAlarm",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "default": "Tapo Alarm"
      },
      "email": {
        "type": "string",
        "format": "email"
      },
      "password": {
        "type": "string"
      },
      "addresses": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "default": "MAC",
              "oneOf": [
                {
                  "title": "IP Address",
                  "enum": [
                    "IP"
                  ],
                  "description": "Set IP only if it's staticly assigned."
                },
                {
                  "title": "MAC Address",
                  "enum": [
                    "MAC"
                  ],
                  "description": "MAC address is the default and will be used to find the Tapo device's IP Address."
                }
              ]
            }
          },
          "required": [
            "value",
            "type"
          ]
        }
      },
      "hiddenDevices": {
        "type": "array",
        "title": "Скрытые устройства",
        "description": "Список устройств, которые не нужно публиковать в HomeKit. Управляется через пользовательский интерфейс плагина.",
        "items": {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "deviceId": {
              "type": "string"
            },
            "deviceType": {
              "type": "string"
            }
          },
          "required": [
            "uuid"
          ]
        }
      }
    },
    "required": [
      "platform",
      "name",
      "email",
      "password",
      "addresses"
    ]
  },
  "customUi": true
}
