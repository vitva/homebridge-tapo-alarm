{
  "private": false,
  "displayName": "Homebridge Tapo Alarm",
  "name": "homebridge-tapo-alarm",
  "version": "1.0.0",
  "description": "Homebridge plugin for Tapo H100 alarm-state reporting and S200 button support",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitva/homebridge-tapo-alarm.git"
  },
  "bugs": {
    "url": "https://github.com/vitva/homebridge-tapo-alarm/issues"
  },
  "contributors": [
    {
      "name": "Kevin Hillinger",
      "url": "https://github.com/kevinhillinger"
    }
  ],
  "engines": {
    "node": "^18.20.4 || >=20.17.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "npm run build:cjs && npm run build:esm",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "prepare": "npm run build",
    "test": "node --test test/*.test.cjs",
    "build:cjs": "rimraf ./dist && tsc",
    "build:esm": "rimraf ./dist-esm && tsc -p tsconfig.esm.json && node scripts/fix-esm-imports.cjs"
  },
  "keywords": [
    "homebridge-plugin",
    "Adaptive Lighting",
    "tplink",
    "tp-link",
    "tp",
    "link",
    "light",
    "bulb",
    "adaptive",
    "lighting",
    "tapo",
    "smart",
    "Smart Home",
    "alarm",
    "security-system",
    "h100",
    "s200"
  ],
  "dependencies": {
    "async-lock": "^1.4.1",
    "axios": "^1.7.9",
    "local-devices": "^4.0.0",
    "homebridge-lib": "^7.1.3"
  },
  "resolutions": {
    "semver": "^7.5.2",
    "dns-packet": "^5.4.0",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@types/async-lock": "^1.4.2",
    "@types/node": "^22.10.10",
    "@typescript-eslint/eslint-plugin": "8.21.0",
    "@typescript-eslint/parser": "8.21.0",
    "eslint": "^9.18.0",
    "homebridge": "^1.8.5",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "exports": {
    ".": {
      "import": "./dist-esm/index.js",
      "require": "./dist/index.js"
    }
  }
}
